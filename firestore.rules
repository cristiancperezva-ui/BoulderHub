rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helpers
    function isAdmin() {
      return request.auth != null && 
        'admin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isRouteSetter() {
      return request.auth != null && 
        'routesetter' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    function isClimber() {
      return request.auth != null && 
        'climber' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roles;
    }

    // Config (admins list)
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      // Requiere sesión iniciada para leer perfiles (evita scraping anónimo
      // masivo de emails/nombres vía API REST de Firestore)
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Solo admin puede cambiar roles de otros
      allow write: if request.auth != null && 
        (request.auth.uid == userId || isAdmin());

      // Subcolección: attempts del usuario (para métricas y filtros)
      match /attempts/{blockId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Walls
    match /walls/{wallId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Color categories
    match /colorCategories/{catId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blocks
    match /blocks/{blockId} {
      allow read: if true;
      allow create: if isAdmin() || isRouteSetter();
      allow update: if request.auth != null && (
        // Routesetter o admin puede hacer cambios completos a cualquier bloque
        (isRouteSetter() || isAdmin())
        ||
        // Cualquier usuario autenticado puede actualizar solo métricas agregadas
        // (intentos, rating, etc.), con validación de tipo/rango para evitar
        // que un cliente malicioso inyecte valores arbitrarios (ej. totalAttempts=999999)
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['avgRating', 'totalAttempts', 'flashCount', 'encadenadoCount', 'proyectoCount', 'ratingSum', 'ratingCount', 'updatedAt'])
          && (!('avgRating' in request.resource.data) ||
              (request.resource.data.avgRating is number &&
               request.resource.data.avgRating >= 0 && request.resource.data.avgRating <= 5))
          && (!('totalAttempts' in request.resource.data) ||
              (request.resource.data.totalAttempts is number &&
               request.resource.data.totalAttempts >= (resource.data.totalAttempts is number ? resource.data.totalAttempts : 0) &&
               request.resource.data.totalAttempts <= (resource.data.totalAttempts is number ? resource.data.totalAttempts : 0) + 1))
          && (!('flashCount' in request.resource.data) || request.resource.data.flashCount is number)
          && (!('encadenadoCount' in request.resource.data) || request.resource.data.encadenadoCount is number)
          && (!('proyectoCount' in request.resource.data) || request.resource.data.proyectoCount is number)
          && (!('ratingCount' in request.resource.data) || request.resource.data.ratingCount is number)
        )
      );
      allow delete: if isAdmin();

      // Subcolección: attempts
      match /attempts/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Challenges
    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.creatorId;
      allow delete: if request.auth != null && (request.auth.uid == resource.data.creatorId || isAdmin());

      // Subcolección: results
      match /results/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Subcolección: ratings
      match /ratings/{userId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId &&
          request.resource.data.rating >= 1 && request.resource.data.rating <= 5;
      }
    }
  }
}
